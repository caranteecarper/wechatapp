<view class="special-date-page theme-{{currentPersona}}">
  <view class="event-hero">
    <image class="event-hero__image" src="{{pageCopy.heroImage}}" mode="aspectFill" />
    <view class="event-hero__veil" />
    <view class="event-hero__content">
      <view class="event-hero__eyebrow">{{pageCopy.eyebrow}}</view>
      <view class="event-hero__title">{{pageCopy.title}}</view>
      <view class="event-hero__subtitle">{{pageCopy.subtitle}}</view>
      <view class="hero-countdown">
        <view class="hero-countdown__value">{{hero.countdownValue}}</view>
        <view class="hero-countdown__unit">{{hero.countdownUnit}}</view>
        <view class="hero-countdown__copy">
          <view class="hero-countdown__label">{{pageCopy.countdownLabel}}</view>
          <view class="hero-countdown__date">{{hero.dateLabel}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="date-section">
    <view class="section-heading">
      <view class="section-heading__eyebrow">{{pageCopy.dateSectionEyebrow}}</view>
      <view class="section-heading__title">{{pageCopy.dateSectionTitle}}</view>
      <view class="section-heading__desc">{{pageCopy.dateSectionDesc}}</view>
    </view>

    <view class="date-list">
      <view
        wx:for="{{eventCards}}"
        wx:key="id"
        class="date-item"
        data-index="{{index}}"
        bindtap="onDateTap"
      >
        <view class="date-item__calendar">
          <view class="date-item__date">{{item.dateText}}</view>
          <view class="date-item__repeat">{{item.repeatText}}</view>
        </view>
        <view class="date-item__body">
          <view class="date-item__title">{{item.title}}</view>
          <view class="date-item__state">{{item.stateText}}</view>
        </view>
        <t-icon name="chevron-right" size="34rpx" class="date-item__arrow" />
      </view>
    </view>
  </view>

  <view class="preparation-band">
    <view class="section-heading section-heading--inverse">
      <view class="section-heading__eyebrow">{{pageCopy.preparationEyebrow}}</view>
      <view class="section-heading__title">{{pageCopy.preparationTitle}}</view>
      <view class="section-heading__desc">{{pageCopy.preparationDesc}}</view>
    </view>
    <view class="preparation-list">
      <view wx:for="{{preparations}}" wx:key="title" class="preparation-item">
        <view class="preparation-item__icon">
          <t-icon name="{{item.icon}}" size="38rpx" />
        </view>
        <view class="preparation-item__copy">
          <view class="preparation-item__title">{{item.title}}</view>
          <view class="preparation-item__desc">{{item.desc}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="event-footer">
    <button class="event-action" bindtap="onCollectDate">
      <t-icon name="calendar" size="34rpx" />
      <text>{{pageCopy.actionText}}</text>
    </button>
  </view>

  <t-toast id="t-toast" />
</view>
