<view class="persona-surface theme-{{currentPersona}} search-page">
  <view class="persona-page-intro">
    <view class="persona-page-eyebrow">{{pageCopy.eyebrow}}</view>
    <view class="persona-page-title">{{pageCopy.title}}</view>
    <view class="persona-page-description">{{pageCopy.description}}</view>
  </view>

  <form class="search-form" bindsubmit="handleSubmit">
    <t-icon name="search" size="34rpx" color="var(--persona-muted)" />
    <input
      class="search-input"
      name="keyword"
      value="{{searchValue}}"
      placeholder="{{pageCopy.placeholder}}"
      placeholder-class="search-placeholder"
      confirm-type="search"
      bindinput="onInput"
      focus
    />
    <view class="search-clear-button" wx:if="{{searchValue}}" bindtap="clearInput">
      <t-icon name="close-circle-filled" size="30rpx" />
    </view>
  </form>

  <view class="persona-section" wx:if="{{historyWords.length}}">
    <view class="persona-section-heading">
      <text>{{pageCopy.recentTitle}}</text>
      <text class="search-clear-history" bindtap="clearHistory">{{pageCopy.clear}}</text>
    </view>
    <view class="search-chips">
      <view
        class="persona-chip"
        wx:for="{{historyWords}}"
        wx:key="*this"
        data-value="{{item}}"
        bindtap="chooseWord"
      >
        {{item}}
      </view>
    </view>
  </view>

  <view class="persona-section">
    <view class="persona-section-heading">{{pageCopy.suggestionTitle}}</view>
    <view class="search-chips">
      <view
        class="persona-chip"
        wx:for="{{pageCopy.suggestions}}"
        wx:key="*this"
        data-value="{{item}}"
        bindtap="chooseWord"
      >
        {{item}}
      </view>
    </view>
  </view>
</view>
