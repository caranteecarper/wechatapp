.search-form {
  box-sizing: border-box;
  display: flex;
  height: 84rpx;
  margin-top: 24rpx;
  padding: 0 24rpx;
  align-items: center;
  gap: 14rpx;
  border: 1rpx solid var(--persona-border);
  border-radius: var(--persona-radius);
  background: var(--persona-panel);
}

.theme-baby .search-form {
  border-radius: 42rpx;
}

.search-input {
  min-width: 0;
  height: 84rpx;
  flex: 1;
  color: var(--persona-ink);
  font-size: 27rpx;
}

.search-placeholder {
  color: var(--persona-muted);
}

.search-clear-button {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  align-items: center;
  justify-content: center;
  color: var(--persona-muted);
}

.search-clear-history {
  padding: 12rpx 0 12rpx 24rpx;
  color: var(--persona-accent);
  font-size: 23rpx;
  font-weight: 500;
}

.search-chips {
  display: flex;
  margin-top: 14rpx;
  flex-wrap: wrap;
  gap: 14rpx;
}
