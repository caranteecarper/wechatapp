<view class="goods-list-container theme-{{currentPersona}}">
  <view class="empty-wrap" wx:if="{{goodsList.length === 0 && hasLoaded}}">
    <t-empty
      t-class="empty-tips"
      size="240rpx"
      description="{{isInteractionPersona ? (currentPersona === 'baby' ? '宝宝没找到这个想要' : currentPersona === 'princess' ? '仆人没找到公主想要的' : '小狗没找到这条指令') : '暂无相关内容'}}"
    />
  </view>
  <view class="category-goods-list" wx:if="{{goodsList.length}}">
    <goods-list
      wr-class="wr-goods-list"
      goodsList="{{goodsList}}"
      theme="{{currentPersona}}"
      bind:click="gotoGoodsDetail"
      bind:addcart="handleAddCart"
    />
  </view>
  <load-more wx:if="{{goodsList.length > 0}}" status="{{loadMoreStatus}}" no-more-text="都在这里了" />
</view>
<t-toast id="t-toast" />
