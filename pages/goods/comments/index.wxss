.feedback-page {
  padding-bottom: calc(env(safe-area-inset-bottom) + 132rpx);
}

.feedback-tabs {
  box-sizing: border-box;
  width: 100%;
  margin-top: 22rpx;
  white-space: nowrap;
}

.feedback-tab {
  display: inline-flex;
  height: 60rpx;
  margin-right: 12rpx;
  padding: 0 24rpx;
  align-items: center;
  color: var(--persona-muted);
  border: 1rpx solid var(--persona-border);
  border-radius: 30rpx;
  background: var(--persona-panel);
  font-size: 24rpx;
}

.theme-princess .feedback-tab,
.theme-teacher .feedback-tab {
  border-radius: var(--persona-radius);
}

.feedback-tab--active {
  color: #fff;
  border-color: var(--persona-deep);
  background: var(--persona-deep);
}

.feedback-list,
.feedback-page .persona-empty {
  margin-top: 20rpx;
}

.feedback-card {
  padding: 28rpx;
}

.feedback-card__top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.feedback-card__title {
  margin-bottom: 6rpx;
  color: var(--persona-ink);
  font-size: 28rpx;
  font-weight: 650;
}

.feedback-score {
  color: var(--persona-accent);
  font-family: Georgia, serif;
  font-size: 27rpx;
  font-weight: 700;
}

.feedback-content {
  margin-top: 22rpx;
  color: var(--persona-ink);
  font-size: 26rpx;
  line-height: 1.75;
}

.feedback-images {
  display: grid;
  margin-top: 20rpx;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
}

.feedback-image {
  width: 100%;
  height: 188rpx;
  border-radius: var(--persona-radius);
  background: var(--persona-soft);
}

.feedback-private {
  display: flex;
  margin-top: 22rpx;
  padding-top: 18rpx;
  align-items: center;
  gap: 8rpx;
  color: var(--persona-muted);
  border-top: 1rpx solid var(--persona-border);
  font-size: 21rpx;
}
