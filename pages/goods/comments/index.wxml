<view class="persona-surface theme-{{currentPersona}} feedback-page">
  <view class="persona-page-intro">
    <view class="persona-page-eyebrow">{{pageCopy.eyebrow}}</view>
    <view class="persona-page-title">{{pageCopy.title}}</view>
    <view class="persona-page-description">{{pageCopy.description}}</view>
  </view>

  <scroll-view class="feedback-tabs" scroll-x enhanced show-scrollbar="{{false}}">
    <view
      class="feedback-tab {{activeTab === index ? 'feedback-tab--active' : ''}}"
      wx:for="{{pageCopy.tabs}}"
      wx:key="*this"
      data-index="{{index}}"
      bindtap="changeTab"
    >
      {{item}}
    </view>
  </scroll-view>

  <view class="feedback-list" wx:if="{{visibleList.length}}">
    <view class="persona-card feedback-card" wx:for="{{visibleList}}" wx:key="id">
      <view class="feedback-card__top">
        <view>
          <view class="feedback-card__title">{{item.title || pageCopy.interactionLabel}}</view>
          <view class="persona-meta">{{item.createdAt}}</view>
        </view>
        <view class="feedback-score">{{item.score}} / 5</view>
      </view>
      <view class="feedback-content">{{item.content}}</view>
      <view class="feedback-images" wx:if="{{item.images.length}}">
        <image
          class="feedback-image"
          wx:for="{{item.images}}"
          wx:for-item="imageItem"
          wx:key="*this"
          src="{{imageItem}}"
          mode="aspectFill"
        />
      </view>
      <view class="feedback-private">
        <t-icon name="lock-on" size="24rpx" />
        <text>{{pageCopy.privateLabel}}</text>
      </view>
    </view>
  </view>

  <view class="persona-card persona-empty" wx:else>
    <view class="persona-empty__mark">
      <t-icon name="chat-heart" size="42rpx" />
    </view>
    <view class="persona-empty__title">{{pageCopy.emptyTitle}}</view>
    <view class="persona-empty__description">{{pageCopy.emptyDescription}}</view>
  </view>

  <view class="persona-safe-bottom"></view>
</view>

<view class="persona-fixed-actions theme-{{currentPersona}}">
  <view class="persona-primary-button" bindtap="createFeedback">{{pageCopy.createText}}</view>
</view>
