<view class="persona-surface theme-{{currentPersona}} feedback-create">
  <view class="persona-page-intro">
    <view class="persona-page-eyebrow">{{pageCopy.eyebrow}}</view>
    <view class="persona-page-title">{{pageCopy.createNavTitle}}</view>
    <view class="persona-page-description">{{pageCopy.description}}</view>
  </view>

  <view class="persona-section persona-card feedback-target">
    <image class="feedback-target__image" src="{{imgUrl}}" mode="aspectFill" />
    <view class="feedback-target__content">
      <view class="feedback-target__label">{{pageCopy.interactionLabel}}</view>
      <view class="feedback-target__title">{{title}}</view>
    </view>
  </view>

  <view class="persona-section persona-card feedback-form">
    <view class="feedback-rate-row">
      <text>{{pageCopy.caredLabel}}</text>
      <t-rate
        value="{{score}}"
        size="24"
        gap="7"
        color="{{['#c59b58', '#ddd4d6']}}"
        data-field="score"
        bind:change="onRateChange"
      />
    </view>
    <view class="feedback-rate-row">
      <text>{{pageCopy.understoodLabel}}</text>
      <t-rate
        value="{{understoodScore}}"
        size="24"
        gap="7"
        color="{{['#c59b58', '#ddd4d6']}}"
        data-field="understoodScore"
        bind:change="onRateChange"
      />
    </view>

    <view class="feedback-textarea-wrap">
      <t-textarea
        t-class="feedback-textarea"
        value="{{content}}"
        maxlength="{{500}}"
        indicator
        placeholder="{{pageCopy.placeholder}}"
        bind:change="onTextAreaChange"
      />
    </view>

    <view class="feedback-upload">
      <t-upload
        media-type="{{['image']}}"
        files="{{uploadFiles}}"
        max="6"
        bind:remove="handleUploadRemove"
        bind:success="handleUploadSuccess"
        gridConfig="{{gridConfig}}"
        imageProps="{{imageProps}}"
      />
    </view>

    <view class="feedback-private-note">
      <t-icon name="lock-on" size="26rpx" />
      <text>{{pageCopy.privateLabel}}</text>
    </view>
  </view>

  <view class="persona-primary-button feedback-submit" bindtap="submitFeedback">{{pageCopy.submit}}</view>
</view>
<t-toast id="t-toast" />
