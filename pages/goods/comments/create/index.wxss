.feedback-create {
  padding-bottom: calc(env(safe-area-inset-bottom) + 56rpx);
}

.feedback-target {
  display: flex;
  padding: 20rpx;
  align-items: center;
}

.feedback-target__image {
  width: 112rpx;
  height: 112rpx;
  flex: none;
  border-radius: var(--persona-radius);
  background: var(--persona-soft);
}

.feedback-target__content {
  min-width: 0;
  padding-left: 22rpx;
}

.feedback-target__label {
  color: var(--persona-accent);
  font-size: 21rpx;
  font-weight: 650;
}

.feedback-target__title {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 8rpx;
  color: var(--persona-ink);
  font-size: 28rpx;
  font-weight: 650;
  line-height: 1.5;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.feedback-form {
  padding: 28rpx;
}

.feedback-rate-row {
  display: flex;
  min-height: 72rpx;
  align-items: center;
  justify-content: space-between;
  color: var(--persona-ink);
  font-size: 26rpx;
}

.feedback-textarea-wrap {
  margin-top: 18rpx;
}

.feedback-textarea {
  min-height: 260rpx !important;
  padding: 22rpx !important;
  border: 1rpx solid var(--persona-border);
  border-radius: var(--persona-radius);
  background: var(--persona-bg) !important;
}

.feedback-upload {
  margin-top: 22rpx;
}

.feedback-private-note {
  display: flex;
  margin-top: 22rpx;
  padding-top: 20rpx;
  align-items: center;
  gap: 10rpx;
  color: var(--persona-muted);
  border-top: 1rpx solid var(--persona-border);
  font-size: 22rpx;
}

.feedback-submit {
  margin-top: 28rpx;
}
