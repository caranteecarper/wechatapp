<view class="persona-surface theme-{{currentPersona}} result-page">
  <form class="result-search" bindsubmit="handleSubmit">
    <t-icon name="search" size="32rpx" color="var(--persona-muted)" />
    <input
      class="result-search__input"
      name="keyword"
      value="{{keywords}}"
      placeholder="{{pageCopy.placeholder}}"
      placeholder-class="result-search__placeholder"
      confirm-type="search"
      bindinput="onInput"
    />
  </form>

  <view class="result-heading">
    <view>
      <view class="persona-page-eyebrow">{{pageCopy.eyebrow}}</view>
      <view class="result-title">{{pageCopy.resultTitle}}</view>
    </view>
    <view class="result-count" wx:if="{{hasLoaded}}">{{goodsList.length}} 项</view>
  </view>

  <view class="result-list" wx:if="{{goodsList.length}}">
    <goods-list
      wr-class="result-goods-list"
      goodsList="{{goodsList}}"
      theme="{{currentPersona}}"
      bind:click="gotoGoodsDetail"
      bind:addcart="handleAddCart"
    />
  </view>

  <view class="persona-card persona-empty" wx:elif="{{hasLoaded}}">
    <view class="persona-empty__mark">
      <t-icon name="search" size="42rpx" />
    </view>
    <view class="persona-empty__title">{{pageCopy.empty}}</view>
    <view class="persona-empty__description">换一个词试试，或者回到清单里慢慢挑。</view>
  </view>

  <view class="result-loading" wx:else>
    {{currentPersona === 'baby' ? '宝宝正在帮你找...' : currentPersona === 'princess' ? '仆人正在帮公主找...' : '小狗正在替姐姐找...'}}
  </view>
</view>
<t-toast id="t-toast" />
