.result-page {
  padding-right: 0;
  padding-left: 0;
}

.result-search {
  box-sizing: border-box;
  display: flex;
  height: 80rpx;
  margin: 0 28rpx;
  padding: 0 22rpx;
  align-items: center;
  gap: 14rpx;
  border: 1rpx solid var(--persona-border);
  border-radius: var(--persona-radius);
  background: var(--persona-panel);
}

.theme-baby .result-search {
  border-radius: 40rpx;
}

.result-search__input {
  min-width: 0;
  height: 80rpx;
  flex: 1;
  color: var(--persona-ink);
  font-size: 27rpx;
}

.result-search__placeholder {
  color: var(--persona-muted);
}

.result-heading {
  display: flex;
  margin: 32rpx 28rpx 20rpx;
  align-items: flex-end;
  justify-content: space-between;
}

.result-title {
  margin-top: 8rpx;
  color: var(--persona-ink);
  font-size: 34rpx;
  font-weight: 700;
}

.theme-princess .result-title {
  font-family: Georgia, "Songti SC", serif;
}

.result-count {
  color: var(--persona-muted);
  font-size: 23rpx;
}

.result-list {
  padding: 20rpx 24rpx 40rpx;
  background: var(--persona-bg);
}

.result-goods-list {
  background: transparent !important;
}

.result-page .persona-empty {
  margin: 40rpx 28rpx 0;
}

.result-loading {
  padding: 180rpx 28rpx;
  color: var(--persona-muted);
  font-size: 25rpx;
  text-align: center;
}
