.voucher-tabs {
  display: grid;
  margin-top: 22rpx;
  padding: 6rpx;
  border: 1rpx solid var(--persona-border);
  border-radius: var(--persona-radius);
  background: var(--persona-panel);
  grid-template-columns: repeat(3, 1fr);
}

.theme-baby .voucher-tabs {
  border-radius: 36rpx;
}

.voucher-tab {
  display: flex;
  height: 60rpx;
  align-items: center;
  justify-content: center;
  color: var(--persona-muted);
  border-radius: var(--persona-radius);
  font-size: 24rpx;
}

.theme-baby .voucher-tab {
  border-radius: 30rpx;
}

.voucher-tab--active {
  color: #fff;
  background: var(--persona-deep);
}

.voucher-list,
.voucher-page .persona-empty {
  margin-top: 20rpx;
}

.voucher-card {
  position: relative;
  display: flex;
  min-height: 184rpx;
  padding: 26rpx 22rpx;
  align-items: center;
}

.voucher-card::before,
.voucher-card::after {
  position: absolute;
  left: 106rpx;
  width: 24rpx;
  height: 24rpx;
  border: 1rpx solid var(--persona-border);
  border-radius: 50%;
  background: var(--persona-bg);
  content: "";
}

.voucher-card::before {
  top: -13rpx;
}

.voucher-card::after {
  bottom: -13rpx;
}

.voucher-card__symbol {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  color: var(--persona-accent);
  border-radius: 50%;
  background: var(--persona-soft);
}

.theme-princess .voucher-card__symbol,
.theme-teacher .voucher-card__symbol {
  border-radius: var(--persona-radius);
}

.voucher-card__content {
  min-width: 0;
  padding: 0 18rpx 0 36rpx;
  flex: 1;
}

.voucher-card__title {
  color: var(--persona-ink);
  font-size: 29rpx;
  font-weight: 700;
}

.theme-princess .voucher-card__title {
  font-family: Georgia, "Songti SC", serif;
}

.voucher-card__subtitle {
  margin-top: 10rpx;
  color: var(--persona-muted);
  font-size: 23rpx;
  line-height: 1.55;
}

.voucher-card__meta {
  margin-top: 12rpx;
  color: var(--persona-accent);
  font-size: 21rpx;
}

.voucher-card__arrow {
  color: var(--persona-muted);
}

.voucher-add {
  margin-top: 24rpx;
  gap: 10rpx;
}
