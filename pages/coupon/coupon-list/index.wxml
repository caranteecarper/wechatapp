<view class="persona-surface theme-{{currentPersona}} voucher-page">
  <view class="persona-page-intro">
    <view class="persona-page-eyebrow">{{pageCopy.eyebrow}}</view>
    <view class="persona-page-title">{{pageCopy.title}}</view>
    <view class="persona-page-description">{{pageCopy.description}}</view>
  </view>

  <view class="voucher-tabs">
    <view
      class="voucher-tab {{activeTab === index ? 'voucher-tab--active' : ''}}"
      wx:for="{{pageCopy.tabs}}"
      wx:key="*this"
      data-index="{{index}}"
      bindtap="changeTab"
    >
      {{item}}
    </view>
  </view>

  <view class="voucher-list" wx:if="{{visibleItems.length}}">
    <view
      class="voucher-card persona-card"
      wx:for="{{visibleItems}}"
      wx:key="key"
      data-id="{{item.key}}"
      bindtap="openDetail"
    >
      <view class="voucher-card__symbol">
        <t-icon name="{{item.icon}}" size="42rpx" />
      </view>
      <view class="voucher-card__content">
        <view class="voucher-card__title">{{item.title}}</view>
        <view class="voucher-card__subtitle">{{item.subtitle}}</view>
        <view class="voucher-card__meta">{{item.meta}}</view>
      </view>
      <view class="voucher-card__arrow">
        <t-icon name="chevron-right" size="38rpx" />
      </view>
    </view>
  </view>

  <view class="persona-card persona-empty" wx:else>
    <view class="persona-empty__mark">
      <t-icon name="ticket" size="42rpx" />
    </view>
    <view class="persona-empty__title">这里还没有专属券</view>
    <view class="persona-empty__description">{{pageCopy.emptyDescription}}</view>
  </view>

  <view class="voucher-add persona-secondary-button" bindtap="addVoucher">
    <t-icon name="add" size="28rpx" />
    <text>{{pageCopy.centerText}}</text>
  </view>
</view>
<t-toast id="t-toast" />
