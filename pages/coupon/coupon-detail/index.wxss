.voucher-detail-card {
  display: flex;
  margin-top: 24rpx;
  padding: 44rpx 34rpx;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.voucher-detail-card__symbol {
  display: flex;
  width: 116rpx;
  height: 116rpx;
  align-items: center;
  justify-content: center;
  color: var(--persona-accent);
  border: 1rpx solid var(--persona-border);
  border-radius: 50%;
  background: var(--persona-soft);
}

.theme-princess .voucher-detail-card__symbol,
.theme-teacher .voucher-detail-card__symbol {
  border-radius: var(--persona-radius);
}

.voucher-detail-card__label {
  margin-top: 26rpx;
  color: var(--persona-gold);
  font-size: 18rpx;
  font-weight: 700;
}

.voucher-detail-card__title {
  margin-top: 10rpx;
  color: var(--persona-ink);
  font-size: 38rpx;
  font-weight: 700;
}

.theme-princess .voucher-detail-card__title {
  font-family: Georgia, "Songti SC", serif;
}

.voucher-detail-card__subtitle {
  max-width: 520rpx;
  margin-top: 14rpx;
  color: var(--persona-muted);
  font-size: 25rpx;
  line-height: 1.7;
}

.voucher-detail-card__meta {
  margin-top: 22rpx;
  padding: 8rpx 18rpx;
  color: var(--persona-accent);
  border: 1rpx solid var(--persona-border);
  border-radius: var(--persona-radius);
  background: var(--persona-bg);
  font-size: 21rpx;
}

.voucher-rules {
  padding: 8rpx 28rpx;
}

.voucher-rule {
  display: flex;
  padding: 26rpx 0;
  gap: 22rpx;
  border-bottom: 1rpx solid var(--persona-border);
}

.voucher-rule:last-child {
  border-bottom: 0;
}

.voucher-rule__index {
  color: var(--persona-gold);
  font-family: Georgia, serif;
  font-size: 24rpx;
  font-weight: 700;
}

.voucher-rule__title {
  color: var(--persona-ink);
  font-size: 26rpx;
  font-weight: 650;
}

.voucher-rule__description {
  margin-top: 8rpx;
  color: var(--persona-muted);
  font-size: 23rpx;
  line-height: 1.65;
}

.voucher-detail-action {
  margin-top: 26rpx;
}
