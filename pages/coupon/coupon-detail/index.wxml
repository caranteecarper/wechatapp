<view class="persona-surface theme-{{currentPersona}} voucher-detail-page">
  <view class="persona-page-intro">
    <view class="persona-page-eyebrow">{{pageCopy.detailEyebrow}}</view>
    <view class="persona-page-title">{{pageCopy.detailTitle}}</view>
    <view class="persona-page-description">{{pageCopy.description}}</view>
  </view>

  <view class="voucher-detail-card persona-card">
    <view class="voucher-detail-card__symbol">
      <t-icon name="{{voucher.icon}}" size="58rpx" />
    </view>
    <view class="voucher-detail-card__label">ONLY FOR US</view>
    <view class="voucher-detail-card__title">{{voucher.title}}</view>
    <view class="voucher-detail-card__subtitle">{{voucher.subtitle}}</view>
    <view class="voucher-detail-card__meta">{{voucher.meta}}</view>
  </view>

  <view class="persona-section persona-card voucher-rules">
    <view class="voucher-rule">
      <view class="voucher-rule__index">01</view>
      <view>
        <view class="voucher-rule__title">怎么使用</view>
        <view class="voucher-rule__description">{{pageCopy.useDescription}}</view>
      </view>
    </view>
    <view class="voucher-rule">
      <view class="voucher-rule__index">02</view>
      <view>
        <view class="voucher-rule__title">适用范围</view>
        <view class="voucher-rule__description">{{pageCopy.scopeDescription}}</view>
      </view>
    </view>
    <view class="voucher-rule">
      <view class="voucher-rule__index">03</view>
      <view>
        <view class="voucher-rule__title">私密说明</view>
        <view class="voucher-rule__description">{{pageCopy.privateDescription}}</view>
      </view>
    </view>
  </view>

  <view class="persona-primary-button voucher-detail-action" bindtap="collectVoucher">{{pageCopy.action}}</view>
</view>
<t-toast id="t-toast" />
