<view class="cart-bar__placeholder" wx:if="{{fixed}}" />
<view class="cart-bar theme-{{theme}} {{fixed ? 'cart-bar--fixed' : ''}} flex flex-v-center" style="bottom: {{fixed ? 'calc(' + bottomHeight + 'rpx + env(safe-area-inset-bottom))' : ''}};">
	<t-icon
	 size="40rpx"
	 color="{{isAllSelected ? (theme === 'teacher' ? '#7D3048' : (theme === 'baby' ? '#DF6F89' : (theme === 'princess' ? '#B85088' : '#E86F86'))) : '#C9B5BA'}}"
	 name="{{isAllSelected ? 'check-circle-filled' : 'circle'}}"
	 class="cart-bar__check"
	 catchtap="handleSelectAll"
	/>
	<text>{{theme === 'teacher' ? '全选指令' : (theme === 'baby' ? '全选抱抱' : (theme === 'princess' ? '全选想要' : '全选心愿'))}}</text>
	<view class="cart-bar__total flex1">
		<view>
			<text class="cart-bar__total--bold text-padding-right">{{theme === 'teacher' ? '听话值' : (theme === 'baby' ? '软糖值' : (theme === 'princess' ? '心意预算' : '心愿值'))}}</text>
			<price
			 price="{{totalAmount || '0'}}"
			 symbol="{{currency}}"
			 fill="{{false}}"
			 decimalSmaller
			 class="cart-bar__total--bold cart-bar__total--price"
			/>
		</view>
	</view>
	<view catchtap="handleToSettle" class="{{!isDisabled ? '' : 'disabled-btn'}} account-btn" hover-class="{{!isDisabled ? '' : 'hover-btn'}}">
		{{sendText || '确认'}}({{totalGoodsNum}})
	</view>
</view>

