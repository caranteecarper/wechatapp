.cart-empty {
  padding: 64rpx 0rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  height: calc(100vh - 100rpx);
  background-color: #fff6f7;
}
.cart-empty .cart-img {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 24rpx;
}

.cart-empty .tip {
  font-size: 28rpx;
  line-height: 40rpx;
  color: #8d7077;
  margin-bottom: 24rpx;
}
.cart-empty .btn {
  width: 240rpx;
  height: 72rpx;
  border-radius: 36rpx;
  text-align: center;
  line-height: 72rpx;
  border: 2rpx solid #e86f86;
  color: #e86f86;
  background-color: transparent;
  font-size: 28rpx;
  font-weight: bold;
}

.cart-empty.theme-teacher {
  background-color: #f7f0ed;
}

.cart-empty.theme-teacher .tip {
  color: #805462;
}

.cart-empty.theme-teacher .btn {
  border-color: #7d3048;
  color: #7d3048;
}

.cart-empty.theme-baby {
  background-color: #fff7f9;
  font-family: "Yuanti SC", "STYuanti-SC-Regular", "YouYuan", "PingFang SC", sans-serif;
}

.cart-empty.theme-baby .cart-img {
  border: 1rpx solid #f0d9df;
  border-radius: 16rpx;
}

.cart-empty.theme-baby .tip {
  color: #9b6d79;
}

.cart-empty.theme-baby .btn {
  border-color: #df6f89;
  color: #c65d76;
}

.cart-empty.theme-princess {
  background-color: #f8f3f1;
}

.cart-empty.theme-princess .cart-img {
  border: 1rpx solid #dfcdbf;
  border-radius: 8rpx;
}

.cart-empty.theme-princess .tip {
  color: #806b69;
}

.cart-empty.theme-princess .btn {
  border-color: #8e3049;
  border-radius: 8rpx;
  color: #8e3049;
}
