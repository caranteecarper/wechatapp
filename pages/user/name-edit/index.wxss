.name-form {
  padding: 30rpx;
}

.name-label {
  color: var(--persona-ink);
  font-size: 26rpx;
  font-weight: 650;
}

.name-input-row {
  display: flex;
  height: 92rpx;
  margin-top: 18rpx;
  padding: 0 22rpx;
  align-items: center;
  border: 1rpx solid var(--persona-border);
  border-radius: var(--persona-radius);
  background: var(--persona-bg);
}

.name-input {
  min-width: 0;
  height: 92rpx;
  flex: 1;
  color: var(--persona-ink);
  font-size: 29rpx;
}

.name-placeholder {
  color: var(--persona-muted);
}

.name-clear {
  padding-left: 20rpx;
  color: var(--persona-accent);
  font-size: 23rpx;
}

.name-help {
  margin-top: 14rpx;
  text-align: right;
}

.name-submit {
  margin-top: 28rpx;
}

.name-submit--disabled {
  opacity: 0.42;
}
