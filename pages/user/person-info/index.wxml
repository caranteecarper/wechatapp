<view class="persona-surface theme-{{currentPersona}} profile-page">
  <view class="persona-page-intro">
    <view class="persona-page-eyebrow">{{pageCopy.eyebrow}}</view>
    <view class="persona-page-title">{{pageCopy.title}}</view>
    <view class="persona-page-description">{{pageCopy.description}}</view>
  </view>

  <view class="profile-identity persona-card">
    <view class="profile-avatar-wrap" bindtap="editAvatar">
      <t-image t-class="profile-avatar" src="{{profile.avatarUrl}}" mode="aspectFill" />
      <view class="profile-avatar-edit">
        <t-icon name="camera" size="28rpx" />
      </view>
    </view>
    <view class="profile-name">{{profile.nickName}}</view>
    <view class="profile-role">{{personaLabel}}</view>
    <view class="profile-private">{{pageCopy.privacy}}</view>
  </view>

  <view class="persona-section profile-fields persona-card">
    <view class="profile-field" bindtap="editAvatar">
      <view>
        <view class="profile-field__label">{{pageCopy.avatarLabel}}</view>
        <view class="profile-field__hint">换一张我喜欢的照片</view>
      </view>
      <t-icon name="chevron-right" size="36rpx" />
    </view>
    <view class="profile-field" bindtap="editName">
      <view>
        <view class="profile-field__label">{{pageCopy.nameLabel}}</view>
        <view class="profile-field__hint">{{pageCopy.nameHint}}</view>
      </view>
      <view class="profile-field__value">
        <text>{{profile.nickName}}</text>
        <t-icon name="chevron-right" size="36rpx" />
      </view>
    </view>
    <view class="profile-field">
      <view class="profile-field__label">{{pageCopy.roleLabel}}</view>
      <view class="profile-field__value">{{personaLabel}}</view>
    </view>
    <view class="profile-field">
      <view class="profile-field__label">{{pageCopy.callLabel}}</view>
      <view class="profile-field__value">{{receiverName}}</view>
    </view>
  </view>
</view>
<t-toast id="t-toast" />
