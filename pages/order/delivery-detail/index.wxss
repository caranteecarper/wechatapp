.progress-sheet {
  margin-top: 24rpx;
  padding: 34rpx 28rpx 12rpx;
}

.progress-step {
  display: flex;
  min-height: 156rpx;
  gap: 22rpx;
}

.progress-step__rail {
  display: flex;
  width: 44rpx;
  flex: none;
  flex-direction: column;
  align-items: center;
}

.progress-step__dot {
  display: flex;
  width: 42rpx;
  height: 42rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  color: var(--persona-muted);
  border: 1rpx solid var(--persona-border);
  border-radius: 50%;
  background: var(--persona-bg);
}

.progress-step__line {
  width: 1rpx;
  flex: 1;
  background: var(--persona-border);
}

.progress-step--active .progress-step__dot {
  color: #fff;
  border-color: var(--persona-accent);
  background: var(--persona-accent);
}

.progress-step--active .progress-step__line {
  background: var(--persona-accent);
}

.theme-princess .progress-step__dot,
.theme-teacher .progress-step__dot {
  border-radius: var(--persona-radius);
}

.progress-step__content {
  min-width: 0;
  padding-bottom: 28rpx;
  flex: 1;
}

.progress-step__number {
  color: var(--persona-muted);
  font-family: Georgia, serif;
  font-size: 17rpx;
  font-weight: 700;
}

.progress-step__title {
  margin-top: 7rpx;
  color: var(--persona-ink);
  font-size: 28rpx;
  font-weight: 700;
}

.theme-princess .progress-step__title {
  font-family: Georgia, "Songti SC", serif;
}

.progress-step__description {
  margin-top: 8rpx;
  color: var(--persona-muted);
  font-size: 23rpx;
  line-height: 1.6;
}

.progress-step__state {
  display: inline-flex;
  margin-top: 12rpx;
  padding: 6rpx 14rpx;
  color: var(--persona-accent);
  border-radius: var(--persona-radius);
  background: var(--persona-soft);
  font-size: 20rpx;
}

.progress-private {
  display: flex;
  margin-top: 20rpx;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: var(--persona-muted);
  font-size: 21rpx;
}
