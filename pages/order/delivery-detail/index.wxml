<view class="persona-surface theme-{{currentPersona}} progress-page">
  <view class="persona-page-intro">
    <view class="persona-page-eyebrow">{{pageCopy.eyebrow}}</view>
    <view class="persona-page-title">{{pageCopy.title}}</view>
    <view class="persona-page-description">{{pageCopy.description}}</view>
  </view>

  <view class="progress-sheet persona-card">
    <view
      class="progress-step {{index <= progressIndex ? 'progress-step--active' : ''}}"
      wx:for="{{pageCopy.steps}}"
      wx:key="title"
    >
      <view class="progress-step__rail">
        <view class="progress-step__dot">
          <t-icon name="{{index < progressIndex ? 'check' : 'circle'}}" size="24rpx" />
        </view>
        <view class="progress-step__line" wx:if="{{index < pageCopy.steps.length - 1}}"></view>
      </view>
      <view class="progress-step__content">
        <view class="progress-step__number">STEP 0{{index + 1}}</view>
        <view class="progress-step__title">{{item.title}}</view>
        <view class="progress-step__description">{{item.description}}</view>
        <view class="progress-step__state" wx:if="{{index === progressIndex}}">正在这里</view>
      </view>
    </view>
  </view>

  <view class="progress-private">
    <t-icon name="lock-on" size="24rpx" />
    <text>这份进度只留在我们之间</text>
  </view>
</view>
