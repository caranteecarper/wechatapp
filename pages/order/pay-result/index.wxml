<view class="persona-surface theme-{{currentPersona}} success-page">
  <view class="success-mark">
    <view class="success-mark__inner">
      <t-icon name="check" size="60rpx" />
    </view>
  </view>

  <view class="persona-page-eyebrow success-eyebrow">{{pageCopy.eyebrow}}</view>
  <view class="success-title">{{pageCopy.title}}</view>
  <view class="success-description">{{pageCopy.description}}</view>
  <view class="success-badge">
    <t-icon name="lock-on" size="24rpx" />
    <text>{{pageCopy.badge}}</text>
  </view>

  <view class="success-divider">
    <view></view>
    <text>只在我们之间</text>
    <view></view>
  </view>

  <view class="success-actions">
    <view class="persona-primary-button" bindtap="viewRecords">{{pageCopy.primary}}</view>
    <view class="persona-secondary-button" bindtap="goHome">{{pageCopy.secondary}}</view>
  </view>
</view>
