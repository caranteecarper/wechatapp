.success-page {
  display: flex;
  padding-top: 120rpx;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.success-mark {
  display: flex;
  width: 160rpx;
  height: 160rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--persona-border);
  border-radius: 50%;
  background: var(--persona-panel);
}

.success-mark__inner {
  display: flex;
  width: 118rpx;
  height: 118rpx;
  align-items: center;
  justify-content: center;
  color: #fff;
  border-radius: 50%;
  background: var(--persona-deep);
}

.theme-princess .success-mark,
.theme-princess .success-mark__inner,
.theme-teacher .success-mark,
.theme-teacher .success-mark__inner {
  border-radius: var(--persona-radius);
}

.success-eyebrow {
  margin-top: 36rpx;
}

.success-title {
  max-width: 620rpx;
  margin-top: 14rpx;
  color: var(--persona-ink);
  font-size: 42rpx;
  font-weight: 750;
  line-height: 1.35;
}

.theme-princess .success-title {
  font-family: Georgia, "Songti SC", serif;
  font-weight: 600;
}

.success-description {
  max-width: 570rpx;
  margin-top: 18rpx;
  color: var(--persona-muted);
  font-size: 25rpx;
  line-height: 1.8;
}

.success-badge {
  display: flex;
  margin-top: 26rpx;
  padding: 12rpx 20rpx;
  align-items: center;
  gap: 8rpx;
  color: var(--persona-accent);
  border: 1rpx solid var(--persona-border);
  border-radius: var(--persona-radius);
  background: var(--persona-soft);
  font-size: 22rpx;
}

.success-divider {
  display: flex;
  width: 100%;
  margin-top: 70rpx;
  align-items: center;
  gap: 16rpx;
  color: var(--persona-gold);
  font-family: Georgia, serif;
  font-size: 17rpx;
}

.success-divider view {
  height: 1rpx;
  flex: 1;
  background: var(--persona-border);
}

.success-actions {
  display: grid;
  width: 100%;
  margin-top: 36rpx;
  gap: 16rpx;
}
