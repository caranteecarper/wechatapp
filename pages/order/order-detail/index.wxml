<view class="persona-surface theme-{{currentPersona}} record-detail-page">
  <view class="persona-page-intro">
    <view class="persona-page-eyebrow">{{pageCopy.eyebrow}}</view>
    <view class="persona-page-title">{{pageCopy.title}}</view>
    <view class="persona-page-description">{{pageCopy.description}}</view>
  </view>

  <view class="record-status persona-card" wx:if="{{order}}">
    <view class="record-status__dot"></view>
    <view>
      <view class="record-status__label">现在的状态</view>
      <view class="record-status__title">{{order.orderStatusName}}</view>
    </view>
    <view class="record-status__index">0{{progressIndex + 1}}</view>
  </view>

  <view class="persona-section" wx:if="{{goodsList.length}}">
    <view class="persona-section-heading">{{pageCopy.contentTitle}}</view>
    <view class="persona-card record-goods">
      <view
        class="record-good"
        wx:for="{{goodsList}}"
        wx:key="spuId"
        data-id="{{item.spuId}}"
        bindtap="openGoods"
      >
        <image class="record-good__image" src="{{item.image}}" mode="aspectFill" />
        <view class="record-good__content">
          <view class="record-good__title">{{item.title}}</view>
          <view class="record-good__specs">{{item.specs}}</view>
        </view>
        <t-icon name="chevron-right" size="34rpx" />
      </view>
    </view>
  </view>

  <view class="persona-section">
    <view class="persona-section-heading">{{pageCopy.noteTitle}}</view>
    <view class="persona-card record-note">
      <view wx:if="{{orderNote}}">
        <view class="record-note__tag">{{currentPersona === 'teacher' ? '下达时补充' : currentPersona === 'princess' ? '公主的小备注' : '当时的小备注'}}</view>
        <view class="record-note__text">{{orderNote}}</view>
      </view>
      <view class="record-note__change" wx:if="{{changeNote}}">
        <view class="record-note__tag">{{changeNote.optionTitle}}</view>
        <view class="record-note__text">{{changeNote.note || changeNote.optionDescription}}</view>
      </view>
      <view class="record-note__empty" wx:if="{{!orderNote && !changeNote}}">{{pageCopy.noNote}}</view>
    </view>
  </view>

  <view class="persona-section" wx:if="{{feedbackSummary}}">
    <view class="persona-section-heading">
      {{currentPersona === 'teacher' ? '姐姐最近一次验收' : currentPersona === 'princess' ? '公主最近一次心情' : '最近一次感受'}}
    </view>
    <view class="persona-card record-feedback">
      <view class="record-feedback__score">{{feedbackSummary.score}} / 5</view>
      <view class="record-feedback__content">{{feedbackSummary.content}}</view>
      <view class="persona-meta">{{feedbackSummary.createdAt}}</view>
    </view>
  </view>

  <view class="persona-section persona-card record-meta" wx:if="{{order}}">
    <view class="record-meta__row">
      <text>{{pageCopy.serialLabel}}</text>
      <text>{{orderNo}}</text>
    </view>
    <view class="record-meta__row">
      <text>{{pageCopy.timeLabel}}</text>
      <text>{{createdAt}}</text>
    </view>
    <view class="record-meta__row">
      <text>谁能看</text>
      <text>我们两个人</text>
    </view>
  </view>

  <view class="record-loading persona-card" wx:if="{{loading}}">正在打开这条记录...</view>

  <view class="record-actions" wx:if="{{order}}">
    <view class="persona-primary-button" bindtap="openProgress">{{pageCopy.progress}}</view>
    <view class="record-actions__secondary">
      <view class="persona-secondary-button" bindtap="openChange">{{pageCopy.change}}</view>
      <view class="persona-secondary-button" bindtap="openFeedback">{{pageCopy.feedback}}</view>
    </view>
  </view>
</view>
