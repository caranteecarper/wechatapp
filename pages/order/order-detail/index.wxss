.record-status {
  position: relative;
  display: flex;
  min-height: 128rpx;
  margin-top: 24rpx;
  padding: 26rpx 30rpx;
  align-items: center;
  gap: 20rpx;
}

.record-status__dot {
  width: 16rpx;
  height: 16rpx;
  flex: none;
  border-radius: 50%;
  background: var(--persona-accent);
  box-shadow: 0 0 0 10rpx var(--persona-soft);
}

.record-status__label {
  color: var(--persona-muted);
  font-size: 18rpx;
  font-weight: 650;
}

.record-status__title {
  margin-top: 8rpx;
  color: var(--persona-ink);
  font-size: 28rpx;
  font-weight: 700;
}

.record-status__index {
  position: absolute;
  right: 28rpx;
  color: var(--persona-border);
  font-family: Georgia, serif;
  font-size: 52rpx;
  font-weight: 700;
}

.record-goods {
  padding: 0 24rpx;
}

.record-good {
  display: flex;
  min-height: 144rpx;
  padding: 20rpx 0;
  align-items: center;
  gap: 20rpx;
  color: var(--persona-muted);
  border-bottom: 1rpx solid var(--persona-border);
}

.record-good:last-child {
  border-bottom: 0;
}

.record-good__image {
  width: 104rpx;
  height: 104rpx;
  flex: none;
  border-radius: var(--persona-radius);
  background: var(--persona-soft);
}

.record-good__content {
  min-width: 0;
  flex: 1;
}

.record-good__title {
  display: -webkit-box;
  overflow: hidden;
  color: var(--persona-ink);
  font-size: 27rpx;
  font-weight: 650;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.record-good__specs {
  margin-top: 8rpx;
  color: var(--persona-muted);
  font-size: 22rpx;
}

.record-note {
  min-height: 112rpx;
  padding: 26rpx;
}

.record-note__tag {
  color: var(--persona-accent);
  font-size: 22rpx;
  font-weight: 650;
}

.record-note__text,
.record-note__empty {
  margin-top: 8rpx;
  color: var(--persona-ink);
  font-size: 25rpx;
  line-height: 1.7;
}

.record-note__empty {
  margin-top: 0;
  color: var(--persona-muted);
}

.record-note__change {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--persona-border);
}

.record-feedback {
  padding: 28rpx;
}

.record-feedback__score {
  color: var(--persona-accent);
  font-size: 30rpx;
  font-weight: 700;
}

.record-feedback__content {
  margin: 16rpx 0 18rpx;
  color: var(--persona-ink);
  font-size: 26rpx;
  line-height: 1.7;
}

.record-meta {
  padding: 8rpx 26rpx;
}

.record-meta__row {
  display: flex;
  min-height: 82rpx;
  align-items: center;
  justify-content: space-between;
  gap: 30rpx;
  color: var(--persona-muted);
  border-bottom: 1rpx solid var(--persona-border);
  font-size: 23rpx;
}

.record-meta__row:last-child {
  border-bottom: 0;
}

.record-meta__row text:last-child {
  color: var(--persona-ink);
  text-align: right;
}

.record-actions {
  display: grid;
  margin-top: 26rpx;
  gap: 14rpx;
}

.record-actions__secondary {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.record-loading {
  margin-top: 24rpx;
  padding: 80rpx 24rpx;
  color: var(--persona-muted);
  font-size: 24rpx;
  text-align: center;
}
