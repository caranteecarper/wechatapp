.confirm-page {
  padding-bottom: calc(env(safe-area-inset-bottom) + 132rpx);
}

.confirm-loading {
  margin-top: 24rpx;
  padding: 80rpx 24rpx;
  color: var(--persona-muted);
  font-size: 24rpx;
  text-align: center;
}

.confirm-list {
  padding: 0 22rpx;
}

.confirm-good {
  display: flex;
  min-height: 142rpx;
  padding: 20rpx 0;
  align-items: center;
  gap: 18rpx;
  border-bottom: 1rpx solid var(--persona-border);
}

.confirm-good:last-child {
  border-bottom: 0;
}

.confirm-good__image {
  width: 102rpx;
  height: 102rpx;
  flex: none;
  border-radius: var(--persona-radius);
  background: var(--persona-soft);
}

.confirm-good__content {
  min-width: 0;
  flex: 1;
}

.confirm-good__title {
  display: -webkit-box;
  overflow: hidden;
  color: var(--persona-ink);
  font-size: 26rpx;
  font-weight: 650;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.confirm-good__specs {
  overflow: hidden;
  margin-top: 8rpx;
  color: var(--persona-muted);
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.confirm-good__quantity {
  color: var(--persona-accent);
  font-size: 23rpx;
}

.confirm-note {
  padding: 26rpx;
}

.confirm-note__title {
  color: var(--persona-ink);
  font-size: 27rpx;
  font-weight: 650;
}

.confirm-note__input {
  box-sizing: border-box;
  width: 100%;
  height: 210rpx;
  margin-top: 18rpx;
  padding: 20rpx;
  color: var(--persona-ink);
  border: 1rpx solid var(--persona-border);
  border-radius: var(--persona-radius);
  background: var(--persona-bg);
  font-size: 25rpx;
  line-height: 1.65;
}

.confirm-note__placeholder {
  color: var(--persona-muted);
}

.confirm-note__count {
  margin-top: 8rpx;
  text-align: right;
}

.confirm-summary {
  padding: 8rpx 26rpx;
}

.confirm-summary__row {
  display: flex;
  min-height: 82rpx;
  align-items: center;
  justify-content: space-between;
  gap: 28rpx;
  color: var(--persona-muted);
  border-bottom: 1rpx solid var(--persona-border);
  font-size: 23rpx;
}

.confirm-summary__row:last-child {
  border-bottom: 0;
}

.confirm-summary__row text:last-child {
  color: var(--persona-ink);
  font-weight: 600;
  text-align: right;
}

.persona-primary-button--disabled {
  opacity: 0.65;
}
