<view class="persona-surface theme-{{currentPersona}} confirm-page">
  <view class="persona-page-intro">
    <view class="persona-page-eyebrow">
      {{currentPersona === 'baby' ? 'SEND A HUG' : currentPersona === 'princess' ? 'ROYAL WISH' : 'PRIVATE ARRANGEMENT'}}
    </view>
    <view class="persona-page-title">
      {{currentPersona === 'baby' ? '把这份心愿告诉宝宝' : currentPersona === 'princess' ? '确认公主想要的' : '确认姐姐的指令'}}
    </view>
    <view class="persona-page-description">
      {{currentPersona === 'baby' ? '确认后，宝宝会看到这份软软的期待。' : currentPersona === 'princess' ? '确认后，仆人就知道今天该怎么宠公主啦。' : '确认后，小狗会收到姐姐清楚明确的要求。'}}
    </view>
  </view>

  <view class="confirm-loading persona-card" wx:if="{{loading}}">正在整理这份心意...</view>

  <view class="persona-section" wx:for="{{orderCardList}}" wx:key="id" wx:for-item="group">
    <view class="persona-section-heading">{{group.title || personaUi.basketName}}</view>
    <view class="persona-card confirm-list">
      <view class="confirm-good" wx:for="{{group.goodsList}}" wx:key="id">
        <image class="confirm-good__image" src="{{item.image}}" mode="aspectFill" />
        <view class="confirm-good__content">
          <view class="confirm-good__title">{{item.title}}</view>
          <view class="confirm-good__specs">{{item.specs}}</view>
        </view>
        <view class="confirm-good__quantity">×{{item.quantity}}</view>
      </view>
    </view>
  </view>

  <view class="persona-section persona-card confirm-note">
    <view class="confirm-note__title">{{personaUi.noteTitle}}</view>
    <textarea
      class="confirm-note__input"
      value="{{note}}"
      maxlength="100"
      placeholder="{{personaUi.notePlaceholder}}"
      placeholder-class="confirm-note__placeholder"
      bindinput="onNoteInput"
    />
    <view class="persona-meta confirm-note__count">{{note.length}} / 100</view>
  </view>

  <view class="persona-section persona-card confirm-summary">
    <view class="confirm-summary__row">
      <text>一共选择</text>
      <text>{{totalCount}} 个{{currentPersona === 'teacher' ? '指令' : currentPersona === 'princess' ? '想要' : '抱抱'}}</text>
    </view>
    <view class="confirm-summary__row">
      <text>{{personaUi.valueName}}</text>
      <text>{{totalValue}}</text>
    </view>
    <view class="confirm-summary__row">
      <text>私密状态</text>
      <text>{{currentPersona === 'teacher' ? '仅姐姐和小狗可见' : currentPersona === 'baby' ? '只留在软软小屋' : '只留在公主的偏爱记录'}}</text>
    </view>
  </view>

  <view class="persona-safe-bottom"></view>
</view>

<view class="persona-fixed-actions theme-{{currentPersona}}">
  <view
    class="persona-primary-button {{submitting ? 'persona-primary-button--disabled' : ''}}"
    bindtap="submitOrder"
  >
    {{submitting ? '正在保存...' : personaUi.sendText}}
  </view>
</view>
<t-toast id="t-toast" />
