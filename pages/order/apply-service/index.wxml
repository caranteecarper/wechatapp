<view class="persona-surface theme-{{currentPersona}} change-page">
  <view class="persona-page-intro">
    <view class="persona-page-eyebrow">{{pageCopy.eyebrow}}</view>
    <view class="persona-page-title">{{pageCopy.title}}</view>
    <view class="persona-page-description">{{pageCopy.description}}</view>
  </view>

  <view class="persona-section">
    <view class="persona-section-heading">选择调整方式</view>
    <view class="change-options">
      <view
        class="change-option persona-card {{selectedKey === item.key ? 'change-option--active' : ''}}"
        wx:for="{{pageCopy.options}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="selectOption"
      >
        <view class="change-option__icon">
          <t-icon name="{{item.icon}}" size="34rpx" />
        </view>
        <view class="change-option__content">
          <view class="change-option__title">{{item.title}}</view>
          <view class="change-option__description">{{item.description}}</view>
        </view>
        <view class="change-option__check">
          <t-icon name="{{selectedKey === item.key ? 'check-circle-filled' : 'circle'}}" size="34rpx" />
        </view>
      </view>
    </view>
  </view>

  <view class="persona-section persona-card change-note">
    <view class="change-note__label">{{pageCopy.noteLabel}}</view>
    <textarea
      class="change-note__input"
      value="{{note}}"
      maxlength="300"
      placeholder="{{pageCopy.notePlaceholder}}"
      placeholder-class="change-note__placeholder"
      bindinput="onNoteInput"
    />
    <view class="persona-meta change-note__count">{{note.length}} / 300</view>
  </view>

  <view
    class="persona-primary-button change-submit {{!selectedKey ? 'change-submit--disabled' : ''}}"
    bindtap="submitChange"
  >
    {{pageCopy.submit}}
  </view>
</view>
<t-toast id="t-toast" />
