.change-options {
  display: grid;
  gap: 14rpx;
}

.change-option {
  display: flex;
  min-height: 126rpx;
  padding: 22rpx;
  align-items: center;
  gap: 18rpx;
}

.change-option--active {
  border-color: var(--persona-accent);
  box-shadow: inset 6rpx 0 0 var(--persona-accent);
}

.theme-baby .change-option--active {
  box-shadow: inset 0 0 0 2rpx var(--persona-accent);
}

.change-option__icon {
  display: flex;
  width: 70rpx;
  height: 70rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  color: var(--persona-accent);
  border-radius: 50%;
  background: var(--persona-soft);
}

.theme-princess .change-option__icon,
.theme-teacher .change-option__icon {
  border-radius: var(--persona-radius);
}

.change-option__content {
  min-width: 0;
  flex: 1;
}

.change-option__title {
  color: var(--persona-ink);
  font-size: 27rpx;
  font-weight: 650;
}

.change-option__description {
  margin-top: 8rpx;
  color: var(--persona-muted);
  font-size: 22rpx;
  line-height: 1.5;
}

.change-option__check {
  color: var(--persona-accent);
}

.change-note {
  padding: 26rpx;
}

.change-note__label {
  color: var(--persona-ink);
  font-size: 27rpx;
  font-weight: 650;
}

.change-note__input {
  box-sizing: border-box;
  width: 100%;
  height: 220rpx;
  margin-top: 18rpx;
  padding: 20rpx;
  color: var(--persona-ink);
  border: 1rpx solid var(--persona-border);
  border-radius: var(--persona-radius);
  background: var(--persona-bg);
  font-size: 25rpx;
  line-height: 1.7;
}

.change-note__placeholder {
  color: var(--persona-muted);
}

.change-note__count {
  margin-top: 10rpx;
  text-align: right;
}

.change-submit {
  margin-top: 26rpx;
}

.change-submit--disabled {
  opacity: 0.42;
}
