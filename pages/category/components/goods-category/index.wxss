.goods-category {
  display: flex;
  width: 100%;
  height: 100%;
  min-height: 0;
  box-sizing: border-box;
  overflow: hidden;
}

.custom-sidebar {
  flex: none;
  height: 100%;
  min-height: 0;
}

.custom-sidebar-shell {
  display: block;
  flex: none;
  align-self: stretch;
  width: 156rpx;
  height: auto;
  min-height: 0;
  overflow: hidden;
}

.goods-category__right {
  height: 100%;
  min-height: 0;
  flex: 1 1 0;
  width: 0;
  min-width: 0;
  position: relative;
  overflow-x: hidden;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  box-sizing: border-box;
  background-color: #fffafa;
}

.flex {
  display: flex;
}

.goods-category-normal {
  margin: 28rpx 20rpx 160rpx;
}

.goods-category-normal-item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 48rpx;
  margin: 0 2rpx 18rpx;
}

.goods-category-normal-item-title {
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 600;
  color: #3f2f35;
}

.goods-category-normal-item-count {
  flex: none;
  margin-left: 16rpx;
  font-size: 22rpx;
  line-height: 34rpx;
  color: #aa8e95;
}

.goods-category-normal-item-container {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx 16rpx;
  margin-bottom: 36rpx;
  box-sizing: border-box;
}

.goods-category-normal-item-container-item {
  min-width: 0;
  min-height: 326rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  padding: 10rpx 10rpx 16rpx;
  border: 1rpx solid #eadfe1;
  border-radius: 12rpx;
  box-sizing: border-box;
  overflow: hidden;
  background-color: #fff;
  box-shadow: 0 8rpx 22rpx rgba(75, 39, 48, 0.07);
}

.goods-category-normal-item-container-item .image {
  width: 100%;
  height: 236rpx;
  border-radius: 10rpx;
  overflow: hidden;
}

.goods-category-normal-item-container-item-title {
  display: -webkit-box;
  width: 100%;
  min-height: 68rpx;
  padding: 0 6rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  line-height: 34rpx;
  text-align: center;
  color: #8d7077;
  margin-top: 14rpx;
  overflow: hidden;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.goods-category .custom-sidebar {
  background-color: #fff0f3;
}

.goods-category.theme-teacher .custom-sidebar {
  background-color: #351820;
}

.goods-category.theme-baby .custom-sidebar {
  background-color: #ffebf0;
}

.goods-category.theme-princess .custom-sidebar {
  background-color: #512431;
}

.goods-category.theme-teacher .goods-category__right {
  background-color: #f4eeec;
}

.goods-category.theme-teacher .goods-category-normal-item-container-item,
.goods-category.theme-teacher .goods-category-normal-item-second-container-item {
  border: 1rpx solid #dfd0cc;
  border-radius: 6rpx;
  background-color: #fffaf6;
  box-shadow: 0 8rpx 20rpx rgba(56, 22, 31, 0.06);
}

.goods-category.theme-teacher .goods-category-normal-item-title {
  color: #3b1721;
  font-family: 'Songti SC', 'STSong', serif;
}

.goods-category.theme-teacher .goods-category-normal-item-count {
  color: #9d7b82;
}

.goods-category.theme-teacher .goods-category-normal-item-container-item-title {
  color: #714652;
}

.goods-category.theme-teacher .goods-category-normal-item-container-item .image {
  border-radius: 4rpx;
}

.goods-category.theme-baby .goods-category__right {
  background-color: #fff7f9;
}

.goods-category.theme-baby .goods-category-normal-item-container-item,
.goods-category.theme-baby .goods-category-normal-item-second-container-item {
  border: 1rpx solid #f0dbe0;
  border-radius: 20rpx;
  background-color: #fffdfd;
  box-shadow: 0 10rpx 26rpx rgba(177, 104, 121, 0.07);
}

.goods-category.theme-baby .goods-category-normal-item-title {
  color: #603d49;
}

.goods-category.theme-baby .goods-category-normal-item-count {
  padding: 0 10rpx;
  border-radius: 16rpx;
  color: #bd7789;
  background-color: #ffedf2;
}

.goods-category.theme-baby .goods-category-normal-item-container-item .image {
  border-radius: 24rpx;
}

.goods-category.theme-baby .goods-category-normal-item-container-item-title {
  color: #9b6d79;
}

.goods-category.theme-princess .goods-category__right {
  background-color: #f8f3f1;
}

.goods-category.theme-princess .goods-category-normal-item-container-item,
.goods-category.theme-princess .goods-category-normal-item-second-container-item {
  border: 1rpx solid #d9c2a6;
  border-radius: 4rpx;
  background-color: #fffcf7;
  box-shadow: 0 10rpx 24rpx rgba(94, 51, 42, 0.06);
}

.goods-category.theme-princess .goods-category-normal-item-title {
  color: #4f2832;
  font-family: 'Songti SC', 'STSong', 'Noto Serif SC', serif;
}

.goods-category.theme-princess .goods-category-normal-item-head {
  padding-bottom: 8rpx;
  border-bottom: 1rpx solid #c6a36f;
}

.goods-category.theme-princess .goods-category-normal-item-count {
  color: #9b794e;
}

.goods-category.theme-princess .goods-category-normal-item-container-item .image {
  border-radius: 2rpx;
}

.goods-category.theme-princess .goods-category-normal-item-container-item-title {
  color: #806b69;
}

.custom-sidebar {
  width: 156rpx;
  height: 100%;
}

.custom-sidebar::-webkit-scrollbar {
  width: 0;
  height: 0;
  color: transparent;
}

.goods-category-normal-item-second-container {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx 16rpx;
  margin-top: 8rpx;
  margin-bottom: 36rpx;
}

.goods-category-normal-item-second-container-item {
  min-width: 0;
  min-height: 326rpx;
  padding: 10rpx 10rpx 16rpx;
  border: 1rpx solid #eadfe1;
  border-radius: 12rpx;
  box-sizing: border-box;
  overflow: hidden;
  background-color: #fff;
  box-shadow: 0 8rpx 22rpx rgba(75, 39, 48, 0.07);
  text-align: center;
}

.goods-category-normal-item-second-container-item .image {
  width: 100%;
  height: 236rpx;
  border-radius: 10rpx;
  overflow: hidden;
}

.goods-category-normal-item-second-container-item-title {
  justify-content: center;
  min-height: 68rpx;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 34rpx;
  color: #222427;
}

.goods-category.theme-teacher .goods-category-normal-item-second-container-item .image {
  border-radius: 4rpx;
}

.goods-category.theme-baby .goods-category-normal-item-second-container-item .image {
  border-radius: 24rpx;
}

.goods-category.theme-princess .goods-category-normal-item-second-container-item .image {
  border-radius: 2rpx;
}
