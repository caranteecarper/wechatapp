.goods-category {
  display: flex;
  height: 100%;
  min-height: 0;
  overflow: hidden;
}

.custom-sidebar {
  height: 100%;
}

.goods-category__right {
  height: 100%;
  flex: auto;
  width: 0;
  min-width: 0;
  position: relative;
  overflow-x: hidden;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  box-sizing: border-box;
  background-color: #fffafa;
}

.flex {
  display: flex;
}

.goods-category-normal {
  margin: 26rpx 24rpx 160rpx;
}

.goods-category-normal-item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 44rpx;
  margin: 0 4rpx 14rpx;
}

.goods-category-normal-item-title {
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 600;
  color: #3f2f35;
}

.goods-category-normal-item-count {
  flex: none;
  margin-left: 16rpx;
  font-size: 20rpx;
  line-height: 32rpx;
  color: #aa8e95;
}

.goods-category-normal-item-container {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 20rpx 8rpx 4rpx;
  margin-bottom: 30rpx;
  display: flex;
  flex-wrap: wrap;
  box-sizing: border-box;
}

.goods-category-normal-item-container-item {
  min-height: 224rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 4rpx 18rpx;
  width: 33.3%;
  box-sizing: border-box;
}

.goods-category-normal-item-container-item .image {
  width: 136rpx;
  height: 136rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.goods-category-normal-item-container-item-title {
  align-items: flex-start;
  justify-content: center;
  width: 100%;
  min-height: 56rpx;
  padding: 0 4rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  line-height: 30rpx;
  text-align: center;
  color: #8d7077;
  margin-top: 12rpx;
  overflow: hidden;
}

.goods-category .custom-sidebar {
  background-color: #fff0f3;
}

.goods-category.theme-teacher .goods-category__right {
  background-color: #f4eeec;
}

.goods-category.theme-teacher .goods-category-normal-item-container,
.goods-category.theme-teacher .goods-category-normal-item-second-container {
  border: 1rpx solid #dfd0cc;
  border-radius: 6rpx;
  background-color: #fffaf6;
  box-shadow: 0 8rpx 20rpx rgba(56, 22, 31, 0.06);
}

.goods-category.theme-teacher .goods-category-normal-item-title {
  color: #3b1721;
  font-family: 'Songti SC', 'STSong', serif;
}

.goods-category.theme-teacher .goods-category-normal-item-count {
  color: #9d7b82;
}

.goods-category.theme-teacher .goods-category-normal-item-container-item-title {
  color: #714652;
}

.goods-category.theme-teacher .goods-category-normal-item-container-item .image {
  border-radius: 4rpx;
}

.goods-category.theme-baby .goods-category__right {
  background-color: #fff7f9;
}

.goods-category.theme-baby .goods-category-normal-item-container,
.goods-category.theme-baby .goods-category-normal-item-second-container {
  border: 1rpx solid #f0dbe0;
  border-radius: 20rpx;
  background-color: #fffdfd;
  box-shadow: 0 10rpx 26rpx rgba(177, 104, 121, 0.07);
}

.goods-category.theme-baby .goods-category-normal-item-title {
  color: #603d49;
}

.goods-category.theme-baby .goods-category-normal-item-count {
  padding: 0 10rpx;
  border-radius: 16rpx;
  color: #bd7789;
  background-color: #ffedf2;
}

.goods-category.theme-baby .goods-category-normal-item-container-item .image {
  border-radius: 24rpx;
}

.goods-category.theme-baby .goods-category-normal-item-container-item-title {
  color: #9b6d79;
}

.goods-category.theme-princess .goods-category__right {
  background-color: #f8f3f1;
}

.goods-category.theme-princess .goods-category-normal-item-container,
.goods-category.theme-princess .goods-category-normal-item-second-container {
  border: 1rpx solid #d9c2a6;
  border-radius: 4rpx;
  background-color: #fffcf7;
  box-shadow: 0 10rpx 24rpx rgba(94, 51, 42, 0.06);
}

.goods-category.theme-princess .goods-category-normal-item-title {
  color: #4f2832;
  font-family: 'Songti SC', 'STSong', 'Noto Serif SC', serif;
}

.goods-category.theme-princess .goods-category-normal-item-head {
  padding-bottom: 8rpx;
  border-bottom: 1rpx solid #c6a36f;
}

.goods-category.theme-princess .goods-category-normal-item-count {
  color: #9b794e;
}

.goods-category.theme-princess .goods-category-normal-item-container-item .image {
  border-radius: 2rpx;
}

.goods-category.theme-princess .goods-category-normal-item-container-item-title {
  color: #806b69;
}

.custom-sidebar {
  width: 180rpx;
  height: 100%;
}

.custom-sidebar::-webkit-scrollbar {
  width: 0;
  height: 0;
  color: transparent;
}

.goods-category-normal-item-second-container {
  background-color: #fff;
  border-radius: 8rpx;
  margin-top: 8rpx;
  margin-bottom: 30rpx;
  display: grid;
  grid-template-columns: 33.33% 33.33% 33.33%;
}

.goods-category-normal-item-second-container-item {
  min-height: 224rpx;
  text-align: center;
  margin-top: 20rpx;
}

.goods-category-normal-item-second-container-item .image {
  width: 136rpx;
  height: 136rpx;
}

.goods-category-normal-item-second-container-item-title {
  justify-content: center;
  font-size: 24rpx;
  color: #222427;
}
