.tabbar-position {
  position: fixed !important;
  bottom: 0;
  left: 0;
  width: 100%;
}

.wrap {
  height: 100vh;
  min-height: 0;
  overflow: hidden;
}
.goods-category-class {
  background-color: #fff6f7 !important;
  height: 100%;
}

.wrap.theme-teacher .goods-category-class {
  background-color: #f7f0ed !important;
}

.wrap.theme-baby .goods-category-class {
  background-color: #fff7f9 !important;
  font-family: 'Yuanti SC', 'STYuanti-SC-Regular', 'YouYuan', 'PingFang SC', sans-serif;
}

.wrap.theme-princess .goods-category-class {
  background-color: #fff7fd !important;
}
.goods-category-class .goods-category-normal-item-container-item {
  margin-top: 20rpx;
}

page {
  height: 100%;
  min-height: 100%;
  padding-bottom: 0;
}
