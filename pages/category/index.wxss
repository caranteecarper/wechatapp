.tabbar-position {
  position: fixed !important;
  bottom: 0;
  left: 0;
  width: 100%;
}

.wrap {
  display: flex;
  width: 100%;
  height: 100%;
  min-height: 0;
  padding-top: 24rpx;
  padding-bottom: calc(96rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow: hidden;
  background-color: #fff6f7;
}

.goods-category-host {
  display: block;
  flex: 1;
  width: 100%;
  min-height: 0;
  overflow: hidden;
}

.goods-category-class {
  background-color: #fff6f7 !important;
  width: 100%;
  height: 100%;
  min-height: 0;
  box-sizing: border-box;
}

.wrap.theme-teacher {
  background-color: #f4eeec;
}

.wrap.theme-teacher .goods-category-class {
  background-color: #f7f0ed !important;
}

.wrap.theme-baby {
  background-color: #fff7f9;
}

.wrap.theme-baby .goods-category-class {
  background-color: #fff7f9 !important;
  font-family: 'Yuanti SC', 'STYuanti-SC-Regular', 'YouYuan', 'PingFang SC', sans-serif;
}

.wrap.theme-princess {
  background-color: #f8f3f1;
}

.wrap.theme-princess .goods-category-class {
  background-color: #f8f3f1 !important;
}
page {
  height: 100%;
  min-height: 100%;
  padding-bottom: 0;
  overflow: hidden;
  background-color: #fff6f7;
}
